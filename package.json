{
  "name": "@narumitw/sketchbook",
  "version": "0.7.0",
  "description": "Local technical walkthroughs with Diagram Design for Pi and MCP agents.",
  "bin": {
    "sketchbook-mcp": "./dist/mcp-cli.js"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/sketchbook.git"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "diagram-design",
    "diagrams"
  ],
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin",
    ".codex-plugin",
    "dist",
    "examples/diagram-design",
    "skills",
    "skills/sketchbook/upstream",
    "docs/compatibility.md",
    "docs/acceptance.md",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build && node scripts/bundle-diagram-design.mjs",
    "check": "biome ci . && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "tsx scripts/package-smoke.ts",
    "ci": "npm run check && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset git-tag",
    "prepare": "node scripts/prepare.mjs"
  },
  "overrides": {
    "katex": "$katex"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@changesets/cli": "^3.0.3",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource-variable/noto-serif-tc": "5.3.1",
    "@fontsource/instrument-serif": "5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/css-tree": "3.2.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.15",
    "typebox": "1.4.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "css-tree": "3.2.1",
    "parse5": "8.1.1",
    "saxes": "6.0.0"
  }
}
