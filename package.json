{
  "name": "@narumitw/sketchbook",
  "version": "0.3.0",
  "description": "Local, hand-drawn Mermaid walkthroughs for Pi and MCP agents.",
  "bin": {
    "sketchbook-mcp": "./dist/mcp-cli.js"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/sketchbook.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "mermaid",
    "diagrams"
  ],
  "files": [
    "dist",
    "skills",
    "docs/compatibility.md",
    "docs/acceptance.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build",
    "check": "biome ci . && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "tsx scripts/package-smoke.ts",
    "ci": "npm run check && npm test && npm run build",
    "changeset": "changeset",
    "release": "npm run build && changeset git-tag",
    "prepare": "husky"
  },
  "overrides": {
    "katex": "$katex"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@changesets/cli": "^3.0.3",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "1.4.6",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^8.3.6",
    "@playwright/test": "^1.58.0",
    "tsx": "^4.21.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "rehype-katex": "^7.0.1",
    "katex": "^0.19.1",
    "mermaid": "12.3.0",
    "dompurify": "^3.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
